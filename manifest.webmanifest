{
  "name": "MESA, ton studio live",
  "short_name": "MESA",
  "description": "Ton live, comme à la télé : invités, habillage et direct, depuis ton navigateur.",
  "lang": "fr",
  "id": "./",
  "start_url": "./index.html?source=appli",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0b0b0d",
  "theme_color": "#0b0b0d",
  "icons": [
    { "src": "img/mesa-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/mesa-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/mesa-masque-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "img/mesa-icone.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Nouveau live", "url": "./index.html#nouveau", "icons": [{ "src": "img/mesa-192.png", "sizes": "192x192" }] },
    { "name": "Mes lives", "url": "./index.html#mes-lives", "icons": [{ "src": "img/mesa-192.png", "sizes": "192x192" }] },
    { "name": "MESA Entreprises", "url": "./entreprises.html", "icons": [{ "src": "img/mesa-192.png", "sizes": "192x192" }] }
  ]
}
